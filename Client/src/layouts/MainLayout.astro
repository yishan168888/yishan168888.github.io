---
import '../styles/main.css';
import '../styles/theme-magic.css';
import '../styles/particles.css';
import '../styles/pixel-wizard.css';
import '../styles/magic-effects.css';
import '../styles/rune-ring.css';
import '../styles/section-divider.css';
import '../styles/corner-ornament.css';
import '../styles/card-hover-magic.css';
import '../styles/cursor-trail.css';
import '../styles/tarot-electric.css';
import HexagramSVG from '../components/HexagramSVG.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import site from '../data/site.json';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  bodyClass?: string;
}

const {
  title = 'LuLu | Personal Advisor for Life & Soul',
  description = 'LuLu 魯魯 — 融合 MMT 人際天賦分析、塔羅解讀與富邦保險的全人陪跑顧問。以臨床護理與靈性的溫柔，陪你看見自己、規劃最適合的人生保障。',
  image = '/img/lulu/lu02.webp',
  bodyClass = 'index-page',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(image, Astro.site).href;
const gaId = site.gaId;
---
<!DOCTYPE html>
<html lang="zh-TW">
  <head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.sitename} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="zh_TW" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Google Analytics 4（填了 site.json 的 gaId 才會載入）-->
    {gaId && (
      <Fragment>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
        <script define:vars={{ gaId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){ dataLayer.push(arguments); }
          gtag('js', new Date());
          gtag('config', gaId);
        </script>
      </Fragment>
    )}

    <!-- 進站 loader 的關鍵樣式（inline 於 head，先於 bundle CSS 套用，避免閃爍） -->
    <style>
      #magic-loader {
        position: fixed; inset: 0; z-index: 9999;
        display: flex; align-items: center; justify-content: center;
        background: #ede4d5;
        transition: opacity 0.55s ease, visibility 0.55s ease;
      }
      #magic-loader.is-hidden { opacity: 0; visibility: hidden; pointer-events: none; }
      .ml-stage { position: relative; width: 170px; height: 170px; display: flex; align-items: center; justify-content: center; }
      .ml-ring-outer, .ml-hex { position: absolute; top: 50%; left: 50%; }
      .ml-ring-outer {
        width: 160px; height: 160px; border-radius: 50%;
        border: 3px solid rgba(26, 16, 8, 0.55);
        box-shadow: 0 0 34px rgba(26,16,8,0.22), inset 0 0 22px rgba(26,16,8,0.12);
        animation: ml-spin 7s linear infinite;
      }
      .ml-hex { width: 96px; height: 96px; animation: ml-spin-rev 5s linear infinite; }
      .ml-hex polygon { fill: none; stroke: rgba(160,92,20,0.6); stroke-width: 1.5; vector-effect: non-scaling-stroke; }
      .ml-hex circle { fill: rgba(160,92,20,0.7); }
      .ml-name {
        position: relative; z-index: 1;
        font-family: 'Raleway', sans-serif; font-weight: 600;
        letter-spacing: 0.22em; text-indent: 0.22em;
        font-size: 1.05rem; color: #3e2d1c;
        animation: ml-breathe 1.8s ease-in-out infinite;
      }
      @keyframes ml-spin     { to { transform: translate(-50%,-50%) rotate(360deg);  } }
      @keyframes ml-spin-rev { to { transform: translate(-50%,-50%) rotate(-360deg); } }
      @keyframes ml-breathe  { 0%,100% { opacity: 0.55; } 50% { opacity: 1; } }
      @media (prefers-reduced-motion: reduce) {
        .ml-ring-outer, .ml-hex, .ml-name { animation: none; }
        #magic-loader { transition: none; }
      }
    </style>
    <!-- 停用 JS 時直接隱藏 loader（魔法陣以靜態呈現，內容照常可讀） -->
    <noscript><style>#magic-loader { display: none !important; }</style></noscript>

    <!-- 結構化資料（個人品牌）-->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "LuLu 魯魯",
      "alternateName": "邱議萱",
      "url": "https://yishan168888.github.io",
      "image": ogImage,
      "jobTitle": "MMT 人際天賦分析師 / 塔羅師 / 富邦保險顧問",
      "sameAs": [site.contact.instagram, site.contact.line]
    })} />

    <!-- Favicons -->
    <link href="/img/favicon.png" rel="icon" />
    <link href="/img/apple-touch-icon.png" rel="apple-touch-icon" />

    <!-- Fonts -->
    <link href="https://fonts.googleapis.com" rel="preconnect" />
    <link href="https://fonts.gstatic.com" rel="preconnect" crossorigin />
    <!-- 只載實際用到的字重（400-900，無斜體、無 100/200/300），大幅縮減首屏字體下載 -->
    <link
      href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;600;700;800;900&family=Poppins:wght@400;500;600;700;800;900&family=Raleway:wght@400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />

    <!-- Vendor CSS -->
    <link href="/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
    <link href="/vendor/bootstrap-icons/bootstrap-icons.css" rel="stylesheet" />
    <link href="/vendor/aos/aos.css" rel="stylesheet" />
    <link href="/vendor/swiper/swiper-bundle.min.css" rel="stylesheet" />
    <link href="/vendor/glightbox/css/glightbox.min.css" rel="stylesheet" />

    <!-- SweetAlert2 -->
    <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11.15.3/dist/sweetalert2.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.15.3/dist/sweetalert2.all.min.js" is:inline></script>

    <!-- Font Awesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />

    <!-- Noto Sans TC -->
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC&display=swap" rel="stylesheet" />

    <slot name="head" />
  </head>

  <body class={bodyClass}>

    <!-- 進站 loader：魔法陣旋轉 → 就緒後淡出（同 session 只第一次顯示） -->
    <div id="magic-loader" aria-hidden="true">
      <div class="ml-stage">
        <div class="ml-ring-outer"></div>
        <HexagramSVG class="ml-hex" />
        <span class="ml-name">LuLu</span>
      </div>
    </div>
    <script is:inline>
      (function () {
        var loader = document.getElementById('magic-loader');
        var KEY = 'lulu_loader_seen';

        function reveal() {
          document.body.classList.add('fx-ready');        // 揭曉後才啟動所有裝飾動畫
          if (!loader) return;
          loader.classList.add('is-hidden');
          setTimeout(function () {
            if (loader && loader.parentNode) loader.parentNode.removeChild(loader);
          }, 650);
        }

        // 同 session 已看過 → 不顯示 loader，動畫立即啟動
        var seen = false;
        try { seen = !!sessionStorage.getItem(KEY); } catch (e) {}
        if (seen) {
          if (loader && loader.parentNode) loader.parentNode.removeChild(loader);
          document.body.classList.add('fx-ready');
          return;
        }

        // 首次進站：顯示 loader，等就緒 + 最短 600ms，最長 2500ms 護欄
        var MIN = 600, MAX = 2500, done = false;
        var hasPerf = !!(window.performance && performance.now);
        var t0 = hasPerf ? performance.now() : 0;

        function finish() {
          if (done) return; done = true;
          try { sessionStorage.setItem(KEY, '1'); } catch (e) {}
          reveal();
        }
        function onReady() {
          var elapsed = (hasPerf ? performance.now() : MIN) - t0;
          setTimeout(finish, Math.max(0, MIN - elapsed));
        }

        if (document.readyState === 'complete') onReady();
        else window.addEventListener('load', onReady);
        setTimeout(finish, MAX);                            // 硬上限：避免 load 卡住時 loader 賴著不走
      })();
    </script>

    <!-- 全域流星（fixed，捲動整個網站都看得到） -->
    <div class="shooting-stars shooting-stars--global" aria-hidden="true">
      <div class="shooting-star" style="--ss-top:6%;--ss-d:24s;--ss-dl:-3s;"></div>
      <div class="shooting-star" style="--ss-top:19%;--ss-d:31s;--ss-dl:-11s;"></div>
      <div class="shooting-star" style="--ss-top:35%;--ss-d:20s;--ss-dl:-18s;"></div>
      <div class="shooting-star" style="--ss-top:53%;--ss-d:27s;--ss-dl:-6s;"></div>
      <div class="shooting-star" style="--ss-top:70%;--ss-d:22s;--ss-dl:-14s;"></div>
      <div class="shooting-star" style="--ss-top:87%;--ss-d:29s;--ss-dl:-9s;"></div>
    </div>

    <Header />
    <main class="main">
      <slot />
    </main>
    <Footer />

    <!-- Vendor JS（body 尾端依序載入，is:inline 防止 Astro 打包） -->
    <script src="/vendor/bootstrap/js/bootstrap.bundle.min.js" is:inline></script>
    <script src="/vendor/php-email-form/validate.js" is:inline></script>
    <script src="/vendor/aos/aos.js" is:inline></script>
    <script src="/vendor/purecounter/purecounter_vanilla.js" is:inline></script>
    <script src="/vendor/imagesloaded/imagesloaded.pkgd.min.js" is:inline></script>
    <script src="/vendor/isotope-layout/isotope.pkgd.min.js" is:inline></script>
    <script src="/vendor/swiper/swiper-bundle.min.js" is:inline></script>
    <script src="/vendor/glightbox/js/glightbox.min.js" is:inline></script>

    <!-- Main JS -->
    <script src="/js/main.js" is:inline></script>

    <!-- Cursor Trail -->
    <script src="/js/cursor-trail.js" is:inline></script>
  </body>
</html>
