---
import site from '../data/site.json';
const { contact } = site;
---
<header id="header" class="header fixed-top">

  <!-- 滾動身份標籤 -->
  <div class="header-marquee" aria-hidden="true">
    <div class="header-marquee-track">
      <span>Soul Advisor</span><span class="hm-dot">·</span>
      <span>MMT 天賦</span><span class="hm-dot">·</span>
      <span>塔羅師</span><span class="hm-dot">·</span>
      <span>保險顧問</span><span class="hm-dot">·</span>
      <span>Soul Advisor</span><span class="hm-dot">·</span>
      <span>MMT 天賦</span><span class="hm-dot">·</span>
      <span>塔羅師</span><span class="hm-dot">·</span>
      <span>保險顧問</span><span class="hm-dot">·</span>
    </div>
  </div>

  <div class="container-fluid container-xl position-relative d-flex align-items-center justify-content-between">
    <a href="/" class="logo d-flex align-items-center">
      <i class="bi bi-buildings"></i>
      <h1 class="sitename">LuLuBOSS</h1>
    </a>

    <!-- 桌面版 Iconic Magic Nav (≥ xl) -->
    <nav class="iconic-nav d-none d-xl-flex" id="magicNav">
      <!-- 隱藏 radio inputs，供 CSS :checked 驅動 -->
      <input type="radio" name="nav-item" id="n-home" checked>
      <input type="radio" name="nav-item" id="n-about">
      <input type="radio" name="nav-item" id="n-work">
      <input type="radio" name="nav-item" id="n-contact">

      <div class="iconic-item" data-for="n-home" data-href="/">
        <label for="n-home"><i class="bi bi-house-heart-fill"></i></label>
      </div>

      <div class="iconic-item iconic-has-dropdown" data-for="n-about">
        <label for="n-about"><i class="bi bi-person-circle"></i></label>
        <ul class="iconic-dropdown">
          <li><a href="/#about-me">我是誰</a></li>
          <li><a href="/#about">MMT天賦系統</a></li>
          <li><a href="/#featured-programs">精選方案</a></li>
        </ul>
      </div>

      <div class="iconic-item iconic-has-dropdown" data-for="n-work">
        <label for="n-work"><i class="bi bi-stars"></i></label>
        <ul class="iconic-dropdown">
          <li><a href={contact.mmtHome} target="_blank">MMT</a></li>
          <li><a href="event-details.html">長期照護服務</a></li>
          <li><a href="privacy.html">護理照護</a></li>
          <li><a href="/insurance">富邦保險</a></li>
          <li><a href="/tarot">塔羅解讀</a></li>
        </ul>
      </div>

      <div class="iconic-item iconic-has-dropdown" data-for="n-contact">
        <label for="n-contact"><i class="bi bi-chat-heart-fill"></i></label>
        <ul class="iconic-dropdown">
          <li>
            <a href={contact.line} target="_blank">
              <i class="bi bi-linkedin me-1"></i>LinkedIn
            </a>
          </li>
          <li>
            <a href={contact.mmtConsult} target="_blank">
              <i class="fas fa-heart me-1"></i>MMT一對一諮詢
            </a>
          </li>
          <li>
            <a href={contact.instagram} target="_blank">
              <i class="bi bi-instagram me-1"></i>Instagram
            </a>
          </li>
        </ul>
      </div>

      <div class="iconic-selector" id="iconicSelector"></div>
    </nav>

    <!-- 行動版選單 (< xl) -->
    <nav id="navmenu" class="navmenu d-xl-none">
      <ul>
        <li><a href="/" class="active">Home</a></li>
        <li class="dropdown">
          <a href="#"><span>關於我</span> <i class="bi bi-chevron-down toggle-dropdown"></i></a>
          <ul>
            <li><a href="#about-me">我是誰</a></li>
            <li><a href="#about">MMT天賦系統</a></li>
            <li><a href="#featured-programs">精選方案</a></li>
          </ul>
        </li>
        <li class="dropdown">
          <a href="#"><span>我的專業</span> <i class="bi bi-chevron-down toggle-dropdown"></i></a>
          <ul>
            <li><a href={contact.mmtHome}>MMT</a></li>
            <li><a href="event-details.html">長期照護服務</a></li>
            <li><a href="privacy.html">護理照護</a></li>
            <li><a href="/insurance">富邦保險</a></li>
            <li><a href="/tarot">塔羅解讀</a></li>
          </ul>
        </li>
        <li class="dropdown">
          <a href="#"><span>聯絡我</span><i class="bi bi-chevron-down toggle-dropdown"></i></a>
          <ul>
            <li>
              <a href={contact.line} target="_blank">
                <i class="bi bi-linkedin me-1"></i> LinkedIn
              </a>
            </li>
            <li>
              <a href={contact.mmtConsult} target="_blank">
                <i class="fas fa-heart me-1"></i> MMT一對一諮詢
              </a>
            </li>
            <li>
              <a href={contact.instagram} target="_blank">
                <i class="bi bi-instagram me-1"></i> Instagram
              </a>
            </li>
          </ul>
        </li>
      </ul>
      <i class="mobile-nav-toggle bi bi-list"></i>
    </nav>
  </div>
</header>

<script>
(function () {
  const nav = document.getElementById('magicNav');
  if (!nav) return;
  const selector = document.getElementById('iconicSelector');

  let ignoreScroll = false;
  let currentActiveItem = null;

  function moveSelector(itemEl) {
    const nr  = nav.getBoundingClientRect();
    const lbl = itemEl.querySelector('label') || itemEl;
    const er  = lbl.getBoundingClientRect();
    const cx  = er.left - nr.left + er.width / 2 - selector.offsetWidth / 2;
    selector.style.transform = `translateY(-50%) translateX(${cx}px)`;
  }

  function setActive(forId, itemEl) {
    const radio = document.getElementById(forId);
    if (radio) radio.checked = true;
    moveSelector(itemEl);
    currentActiveItem = itemEl;
  }

  // 初始定位（等 layout 完成再算）
  requestAnimationFrame(() => {
    const home = nav.querySelector('.iconic-item[data-for="n-home"]');
    if (home) {
      moveSelector(home);
      currentActiveItem = home;
    }
  });

  // Hover：圓泡跟著游標 icon 移動
  nav.querySelectorAll('.iconic-item').forEach(item => {
    item.addEventListener('mouseenter', () => {
      moveSelector(item);
    });
  });

  // 游標離開整個 nav：圓泡回到目前 active item
  nav.addEventListener('mouseleave', () => {
    if (currentActiveItem) moveSelector(currentActiveItem);
  });

  // 點擊：正式更新 active state + 頁面跳轉
  nav.querySelectorAll('.iconic-item').forEach(item => {
    const lbl = item.querySelector('label');
    if (!lbl) return;

    lbl.addEventListener('click', () => {
      setActive(item.dataset.for, item);
      if (item.dataset.href) {
        window.location.href = item.dataset.href;
      }
      ignoreScroll = true;
      setTimeout(() => { ignoreScroll = false; }, 800);
    });
  });

  // 捲動時自動跟隨
  const sectionMap = {
    'hero':             'n-home',
    'about-me':         'n-about',
    'about':            'n-about',
    'featured-programs':'n-about',
  };

  Object.entries(sectionMap).forEach(([id, forId]) => {
    const sec  = document.getElementById(id);
    const item = nav.querySelector(`.iconic-item[data-for="${forId}"]`);
    if (!sec || !item) return;
    new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (e.isIntersecting && !ignoreScroll) setActive(forId, item);
      });
    }, { threshold: 0.4 }).observe(sec);
  });
})();
</script>

<script>
(function () {
  // 隱藏後台入口：在首頁連點 logo 5 下（2 秒內）→ 進入 /admin/
  // 安全性由 GitHub 登入＋repo 權限把關，此處僅為「不顯眼」的便捷入口。
  const logo = document.querySelector('#header .logo');
  if (!logo) return;
  const onHome = location.pathname === '/' || location.pathname === '/index.html';
  let count = 0, timer;
  logo.addEventListener('click', function (e) {
    if (!onHome) return;            // 其他頁面：logo 維持正常導回首頁
    e.preventDefault();             // 首頁：攔截點擊（已在首頁，原本就不需跳轉）
    count++;
    clearTimeout(timer);
    timer = setTimeout(function () { count = 0; }, 1500);
    if (count >= 5) { count = 0; window.location.href = '/admin/'; }
  });
})();
</script>
