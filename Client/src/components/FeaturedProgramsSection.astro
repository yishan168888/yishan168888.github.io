---
import { getCollection } from 'astro:content';
const programs = (await getCollection('programs')).sort((a, b) => a.data.order - b.data.order);
---
<section id="featured-programs" class="programs-cyber section" style="position:relative;overflow:hidden;">
  <!-- Corner Ornament -->
  <div class="corner-ornament corner-ornament--tr" aria-hidden="true">
    <div class="co-ring co-ring-1"></div>
    <div class="co-ring co-ring-2"></div>
    <div class="co-ring co-ring-3"></div>
    <div class="co-dot"></div>
    <div class="co-cross-h"></div>
    <div class="co-cross-v"></div>
  </div>
  <div class="corner-ornament corner-ornament--bl" aria-hidden="true">
    <div class="co-ring co-ring-1"></div>
    <div class="co-ring co-ring-2"></div>
    <div class="co-dot"></div>
  </div>

  <!-- Floating particles -->
  <div class="magic-particles" aria-hidden="true">
    <span class="mp" style="top:5%;right:4%;--sz:0.8rem;--d:9s;--dl:0s;--op:0.40;">✦</span>
    <span class="mp" style="top:30%;left:2%;--sz:0.6rem;--d:12s;--dl:-3s;--op:0.32;">✧</span>
    <span class="mp" style="bottom:12%;right:8%;--sz:0.9rem;--d:10s;--dl:-5s;--op:0.38;">✸</span>
    <span class="mp" style="top:60%;right:3%;--sz:0.55rem;--d:14s;--dl:-2s;--op:0.28;">✺</span>
    <span class="mp" style="bottom:25%;left:5%;--sz:0.7rem;--d:11s;--dl:-7s;--op:0.34;">✦</span>
    <span class="mp" style="top:15%;left:15%;--sz:0.5rem;--d:13s;--dl:-4s;--op:0.26;">✧</span>
  </div>

  <div class="container" data-aos="fade-up">
    <div class="cyber-section-header">
      <span class="cyber-section-tag">SPECIALTIES</span>
      <h2 class="cyber-section-title">專業整合 · <em>貼近人心</em></h2>
      <p style="margin-top:14px;color:rgba(232,224,213,0.48);font-size:0.92rem;max-width:520px;">
        從臨床護理到保險顧問，結合心理學、MMT 與靈性覺察，打造最貼近人心的支持與保障。
      </p>
    </div>
  </div>

  <div class="container" data-aos="fade-up" data-aos-delay="80">
    <div class="isotope-layout" data-default-filter="*" data-layout="masonry" data-sort="original-order">

      <!-- Filters -->
      <ul class="cyber-filter-bar isotope-filters" data-aos="fade-up" data-aos-delay="100">
        <li data-filter="*" class="filter-active">ALL</li>
        <li data-filter=".filter-bachelor">MMT</li>
        <li data-filter=".filter-master">護理照護</li>
        <li data-filter=".filter-certificate">富邦保險</li>
      </ul>

      <div class="row g-3 isotope-container">

        {programs.map((program, i) => {
          const p = program.data;
          return (
            <div class={`col-lg-6 isotope-item ${p.filter}`} data-aos="zoom-in" data-aos-delay={100 + (i % 3) * 80}>
              <div class="program-cyber-card">
                <div class="card-shimmer"></div>
                <div class="program-badge">{p.badge}</div>
                <div class="row g-0">
                  <div class="col-md-4">
                    <div class="program-image-wrapper" style="min-height:200px;">
                      <a href={p.image} class="glightbox" data-gallery="mmt">
                        <img src={p.image} class="img-fluid" alt={p.title} loading="lazy" decoding="async" />
                      </a>
                    </div>
                  </div>
                  <div class="col-md-8">
                    <div class="program-content">
                      <h3>{p.title}</h3>
                      <div class="program-highlights">
                        <span><i class="bi bi-stars"></i> {p.zodiac}</span>
                        <span><i class="bi bi-person-fill"></i> {p.type}</span>
                      </div>
                      <p>{p.description}</p>
                      <a href={p.link} class="program-btn"><span>Learn More</span><i class="bi bi-arrow-right"></i></a>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          );
        })}

      </div>
    </div>
  </div>
</section>
