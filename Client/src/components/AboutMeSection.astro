---
import site from '../data/site.json';
const { contact } = site;
---
<section id="about-me" class="about-cyber section">

  <!-- Aurora -->
  <div class="aurora-overlay">
    <div class="aurora-1"></div>
    <div class="aurora-2"></div>
  </div>

  <!-- Floating particles -->
  <div class="magic-particles" aria-hidden="true">
    <span class="mp" style="top:8%;right:5%;--sz:0.9rem;--d:8s;--dl:0s;--op:0.45;">✦</span>
    <span class="mp" style="top:50%;left:2%;--sz:0.65rem;--d:11s;--dl:-3s;--op:0.35;">✧</span>
    <span class="mp" style="bottom:10%;right:10%;--sz:1rem;--d:9s;--dl:-5s;--op:0.48;">✸</span>
    <span class="mp" style="top:25%;right:15%;--sz:0.55rem;--d:13s;--dl:-1s;--op:0.30;">✦</span>
    <span class="mp" style="top:70%;left:8%;--sz:0.7rem;--d:10s;--dl:-7s;--op:0.38;">✺</span>
    <span class="mp" style="top:15%;left:25%;--sz:0.5rem;--d:14s;--dl:-4s;--op:0.28;">✧</span>
    <span class="mp" style="bottom:20%;left:40%;--sz:0.6rem;--d:12s;--dl:-2s;--op:0.32;">✸</span>
    <span class="mp" style="top:40%;right:28%;--sz:0.75rem;--d:11s;--dl:-6s;--op:0.36;">✦</span>
  </div>

  <!-- Corner Ornament -->
  <div class="corner-ornament corner-ornament--tr" aria-hidden="true">
    <div class="co-ring co-ring-1"></div>
    <div class="co-ring co-ring-2"></div>
    <div class="co-ring co-ring-3"></div>
    <div class="co-dot"></div>
    <div class="co-cross-h"></div>
    <div class="co-cross-v"></div>
  </div>
  <div class="corner-ornament corner-ornament--bl" aria-hidden="true">
    <div class="co-ring co-ring-1"></div>
    <div class="co-ring co-ring-2"></div>
    <div class="co-dot"></div>
  </div>

  <div class="container" style="position:relative;z-index:2;">

    <div class="cyber-section-header" data-aos="fade-up">
      <span class="cyber-section-tag">WHO I AM</span>
      <h2 class="cyber-section-title">關於<em>我</em></h2>
    </div>

    <div class="cyber-bento" data-aos="fade-up" data-aos-delay="80">

      <!-- Photo -->
      <div class="cyber-tile cyber-photo" data-aos="fade-right" data-aos-delay="100">
        <img src="/img/lulu/lu02.webp" alt="LuLu 魯魯" loading="lazy" decoding="async" />
        <div class="cyber-photo-caption">SoulFlow · 靈感旅人</div>
      </div>

      <!-- Statement -->
      <div class="cyber-tile cyber-statement" data-aos="fade-left" data-aos-delay="100">
        <div class="card-shimmer"></div>
        <p class="cyber-statement-quote">照顧他人曾是我的職責，如今是我的選擇。</p>
        <p class="cyber-statement-body">
          我是魯魯，一位融合靈性療癒與專業保險的陪跑者，用溫柔與洞察陪伴人們穿越人生轉折。
          橫跨護理、靈性、保險、教育，我相信每一個人都有能力改寫自己的人生劇本——只需要一位懂你的陪跑者。
        </p>
      </div>

      <!-- 個案陪跑 -->
      <div class="cyber-tile cyber-feature" data-aos="zoom-in" data-aos-delay="150">
        <div class="card-shimmer"></div>
        <div class="cyber-feature-icon">👥</div>
        <h4>個案陪跑</h4>
        <p>從 MMT 天賦系統出發，協助你梳理生命故事，看見內在渴望與卡點，找到真正適合你的節奏與方向。</p>
        <a href={contact.mmtHome} target="_blank">指定我諮詢 →</a>
      </div>

      <!-- 靈性療癒 / 塔羅師 -->
      <div class="cyber-tile cyber-feature" data-aos="zoom-in" data-aos-delay="200">
        <div class="card-shimmer"></div>
        <div class="cyber-feature-icon">🔮</div>
        <h4>塔羅師 · 靈性療癒</h4>
        <p>使用偉特塔羅，結合精油與意識對話，透過高敏感與直覺力，陪你看見潛藏的能量訊息，回到內在力量。感情、事業、靈性皆可解讀。</p>
        <div style="display:flex;gap:10px;margin-top:auto;flex-wrap:wrap;">
          <a href={contact.line} target="_blank" style="font-size:0.77rem;color:#c87a30;font-weight:700;text-decoration:none;opacity:0.9;transition:all 0.2s;">LINE 預約 →</a>
          <a href={contact.instagram} target="_blank" style="font-size:0.77rem;color:#c87a30;font-weight:700;text-decoration:none;opacity:0.9;transition:all 0.2s;">IG 洽詢 →</a>
        </div>
      </div>

      <!-- 保險顧問 wide -->
      <div class="cyber-tile cyber-feature-wide" data-aos="zoom-in" data-aos-delay="250">
        <div class="card-shimmer"></div>
        <div class="cyber-feature-icon">💼</div>
        <h4>保險顧問 × 個人特質</h4>
        <p>擁有專業臨床護理背景，理解身體與醫療的細節。結合 MMT 天賦系統與心理學觀察力，幫助你找出「真正適合」自己的保單配置。</p>
        <a href="/insurance">了解富邦保險服務 →</a>
      </div>

      <!-- 多元整合 -->
      <div class="cyber-tile cyber-feature" data-aos="zoom-in" data-aos-delay="300">
        <div class="card-shimmer"></div>
        <div class="cyber-feature-icon">🌏</div>
        <h4>多元整合</h4>
        <p>橫跨護理、靈性、保險、教育，擁有架構式思維與整合力——這是我提供服務時最大的價值來源。</p>
      </div>

    </div>
  </div>
</section>
