---
import site from '../data/site.json';
const { contact, booking } = site;
---
<footer id="footer" class="footer position-relative dark-background">
  <div class="container footer-top">
    <div class="row gy-4">
      <div class="col-lg-4 col-md-6 footer-about">
        <a href="/" class="logo d-flex align-items-center">
          <span class="sitename">LuLuBOSS</span>
        </a>
        <div class="footer-contact pt-3">
          <p>台灣</p>
          <p class="mt-3"><strong>Phone:</strong> <span>{contact.phone}</span></p>
          <p><strong>Email:</strong> <span>{contact.email}</span></p>
        </div>
        <div class="social-links d-flex mt-4">
          <a href=""><i class="bi bi-facebook"></i></a>
          <a href={contact.instagram}><i class="bi bi-instagram"></i></a>
          <a href={contact.line}><i class="bi bi-linkedin"></i></a>
        </div>
      </div>

      <div class="col-lg-2 col-md-3 footer-links">
        <h4>關於我</h4>
        <ul>
          <li><a href="#about-me">About us</a></li>
          <li><a href="#about">MMT天賦系統</a></li>
          <li><a href="#featured-programs">專長介紹</a></li>
        </ul>
      </div>

      <div class="col-lg-2 col-md-3 footer-links">
        <h4>業務範圍</h4>
        <ul>
          <li><a href={contact.mmtConsult}>MMT一對一諮詢</a></li>
          <li><a href="event-details.html">長期照護服務</a></li>
          <li><a href="privacy.html">護理照護</a></li>
          <li><a href="/insurance">富邦保險</a></li>
        </ul>
      </div>

      <div class="col-lg-2 col-md-3 footer-links">
        <h4>聯絡我</h4>
        <ul>
          <li>
            <a href={booking.appointment} target="_blank"><i class="bi bi-calendar-check"></i> 線上預約</a>
          </li>
          <li>
            <a href={booking.form} target="_blank"><i class="bi bi-pencil-square"></i> 諮詢表單</a>
          </li>
          <li>
            <a href={contact.line}><i class="bi bi-linkedin"></i> LinkedIn</a>
          </li>
          <li>
            <a href={contact.mmtConsult} target="_blank">
              <i class="fas fa-heart me-1"></i> MMT一對一諮詢
            </a>
          </li>
          <li>
            <a href={contact.instagram}><i class="bi bi-instagram"></i>Instagram</a>
          </li>
        </ul>
      </div>
    </div>
  </div>

  <div class="container copyright text-center mt-4">
    <p>© 2025 <strong class="px-1 sitename">SoulFlow</strong> 版權所有</p>
    <div class="credits">
      改版設計 by LuLu謙｜原始模板來自 <a href="https://bootstrapmade.com/">BootstrapMade</a>
      ｜<a href="/tarot-journal/moon-journal.html" style="opacity:0.6;">🌙 塔羅日誌</a>
    </div>
  </div>
</footer>

<!-- Scroll Top -->
<a href="#" id="scroll-top" class="scroll-top d-flex align-items-center justify-content-center">
  <i class="bi bi-arrow-up-short"></i>
</a>
