---
import MainLayout from '../layouts/MainLayout.astro';
import HeroSection from '../components/HeroSection.astro';
import AboutMeSection from '../components/AboutMeSection.astro';
import MMTSection from '../components/MMTSection.astro';
import FeaturedProgramsSection from '../components/FeaturedProgramsSection.astro';
import TarotSection from '../components/TarotSection.astro';
import SectionDivider from '../components/SectionDivider.astro';
---
<MainLayout title="LuLu | Personal Advisor for Life & Soul" bodyClass="index-page cyber-page">
    <HeroSection />

    <SectionDivider variant={0} />

    <AboutMeSection />

    <SectionDivider variant={1} dark />

    <MMTSection />

    <SectionDivider variant={2} />

    <FeaturedProgramsSection />

    <SectionDivider variant={3} dark />

    <TarotSection />
</MainLayout>
