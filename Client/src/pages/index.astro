---
import MainLayout from '../layouts/MainLayout.astro';
import HeroSection from '../components/HeroSection.astro';
import AboutMeSection from '../components/AboutMeSection.astro';
import MMTSection from '../components/MMTSection.astro';
import FeaturedProgramsSection from '../components/FeaturedProgramsSection.astro';
import TarotSection from '../components/TarotSection.astro';
---
<MainLayout title="LuLu | Personal Advisor for Life & Soul" bodyClass="index-page cyber-page">
    <HeroSection />

    <div class="magic-divider" aria-hidden="true">
      <div class="film-strip-row film-strip-row--top"></div>
      <div class="magic-divider-line"></div>
      <div class="magic-divider-symbols">
        <span>✦</span><span>ᚠ</span><span>✸</span><span>ᛏ</span><span>✦</span><span>ᚢ</span><span>✸</span>
      </div>
      <div class="film-strip-row film-strip-row--bottom"></div>
    </div>

    <AboutMeSection />

    <div class="magic-divider on-dark" aria-hidden="true">
      <div class="film-strip-row film-strip-row--top"></div>
      <div class="magic-divider-line"></div>
      <div class="magic-divider-symbols">
        <span>✧</span><span>ᛟ</span><span>✦</span><span>ᚱ</span><span>✧</span><span>ᛞ</span><span>✦</span>
      </div>
      <div class="film-strip-row film-strip-row--bottom"></div>
    </div>

    <MMTSection />

    <div class="magic-divider" aria-hidden="true">
      <div class="film-strip-row film-strip-row--top"></div>
      <div class="magic-divider-line"></div>
      <div class="magic-divider-symbols">
        <span>✸</span><span>ᛁ</span><span>✦</span><span>ᚺ</span><span>✸</span><span>ᛈ</span><span>✦</span>
      </div>
      <div class="film-strip-row film-strip-row--bottom"></div>
    </div>

    <FeaturedProgramsSection />

    <div class="magic-divider on-dark" aria-hidden="true">
      <div class="film-strip-row film-strip-row--top"></div>
      <div class="magic-divider-line"></div>
      <div class="magic-divider-symbols">
        <span>☽</span><span>✦</span><span>★</span><span>✦</span><span>☽</span>
      </div>
      <div class="film-strip-row film-strip-row--bottom"></div>
    </div>

    <TarotSection />
</MainLayout>
