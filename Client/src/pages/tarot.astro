---
import MainLayout from '../layouts/MainLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import site from '../data/site.json';
const { contact, booking } = site;
---

<MainLayout
  title="塔羅解讀 | LuLu 魯魯"
  description="LuLu 魯魯的偉特塔羅解讀：感情、事業、靈性探索，以直覺與象徵語言陪你看清當下能量與方向。可透過 LINE 或 Instagram 預約。"
  bodyClass="index-page cyber-page"
>
  <Header />
  <main class="main">

<!-- SVG Filter（電氣邊框，/tarot 頁自有一份避免 id 衝突） -->
<svg style="position:absolute;width:0;height:0;overflow:hidden;" aria-hidden="true">
  <defs>
    <filter id="tarot-turbulent-displace" colorInterpolationFilters="sRGB" x="-20%" y="-20%" width="140%" height="140%">
      <feTurbulence type="turbulence" baseFrequency="0.018" numOctaves="8" result="noise1" seed="3" />
      <feOffset in="noise1" dx="0" dy="0" result="offsetNoise1">
        <animate attributeName="dy" values="600; 0" dur="7s" repeatCount="indefinite" calcMode="linear" />
      </feOffset>
      <feTurbulence type="turbulence" baseFrequency="0.018" numOctaves="8" result="noise2" seed="3" />
      <feOffset in="noise2" dx="0" dy="0" result="offsetNoise2">
        <animate attributeName="dy" values="0; -600" dur="7s" repeatCount="indefinite" calcMode="linear" />
      </feOffset>
      <feTurbulence type="turbulence" baseFrequency="0.018" numOctaves="8" result="noise3" seed="7" />
      <feOffset in="noise3" dx="0" dy="0" result="offsetNoise3">
        <animate attributeName="dx" values="420; 0" dur="7s" repeatCount="indefinite" calcMode="linear" />
      </feOffset>
      <feTurbulence type="turbulence" baseFrequency="0.018" numOctaves="8" result="noise4" seed="7" />
      <feOffset in="noise4" dx="0" dy="0" result="offsetNoise4">
        <animate attributeName="dx" values="0; -420" dur="7s" repeatCount="indefinite" calcMode="linear" />
      </feOffset>
      <feComposite in="offsetNoise1" in2="offsetNoise2" result="part1" />
      <feComposite in="offsetNoise3" in2="offsetNoise4" result="part2" />
      <feBlend in="part1" in2="part2" mode="color-dodge" result="combinedNoise" />
      <feDisplacementMap in="SourceGraphic" in2="combinedNoise" scale="60" xChannelSelector="R" yChannelSelector="B" />
    </filter>
  </defs>
</svg>

    <!-- ── Hero ─────────────────────────────────────────── -->
    <section class="tarot-page-hero">

      <!-- Aurora -->
      <div class="aurora-overlay">
        <div class="aurora-1"></div>
        <div class="aurora-2"></div>
      </div>

      <!-- 月相粒子 -->
      <div class="magic-particles" aria-hidden="true">
        <span class="tarot-mp" style="top:10%;right:8%;--sz:1.1rem;--d:9s;--dl:0s;--op:0.50;">☽</span>
        <span class="tarot-mp" style="top:60%;left:5%;--sz:0.8rem;--d:12s;--dl:-4s;--op:0.38;">★</span>
        <span class="tarot-mp" style="bottom:15%;right:12%;--sz:0.9rem;--d:10s;--dl:-2s;--op:0.42;">☆</span>
        <span class="tarot-mp" style="top:30%;left:10%;--sz:0.6rem;--d:14s;--dl:-7s;--op:0.30;">✦</span>
        <span class="tarot-mp" style="top:75%;right:20%;--sz:0.55rem;--d:11s;--dl:-5s;--op:0.28;">☽</span>
      </div>

      <div class="container" style="position:relative;z-index:2;">
        <div class="row align-items-center g-5">

          <!-- 左：文字 -->
          <div class="col-lg-6" data-aos="fade-right">
            <div class="tarot-hero-badge">塔羅師 · Tarot Reader</div>
            <h1 class="tarot-hero-name">LuLu 魯魯</h1>
            <p class="tarot-hero-sub">偉特塔羅 · 感情 · 事業 · 靈性成長</p>
            <p style="font-size:0.96rem;color:rgba(247,242,234,0.58);line-height:2;margin-bottom:36px;max-width:480px;">
              學習偉特塔羅以來，我深刻感受到每一張牌背後承載的生命智慧。
              以直覺與象徵語言為媒介，我陪你穿越迷霧，看清當下真正的能量與方向。
            </p>
            <div class="tarot-cta-row">
              <a href={booking.appointment} target="_blank" class="btn-tarot-line">
                <i class="bi bi-calendar-check"></i> 線上預約時段
              </a>
              <a href={contact.line} target="_blank" class="btn-tarot-line">
                <i class="bi bi-chat-fill"></i> LINE 預約解牌
              </a>
              <a href={contact.instagram} target="_blank" class="btn-tarot-ig">
                <i class="bi bi-instagram"></i> IG 追蹤
              </a>
            </div>
          </div>

          <!-- 右：電氣卡片 -->
          <div class="col-lg-6 d-flex justify-content-center" data-aos="fade-left" data-aos-delay="120">
            <div class="tarot-electric-wrap">
              <div class="tarot-electric-card">
                <div class="tarot-electric-inner">
                  <div class="tarot-electric-border">
                    <div class="tarot-electric-main"></div>
                  </div>
                  <div class="tarot-glow-1"></div>
                  <div class="tarot-glow-2"></div>
                </div>
                <div class="tarot-overlay-1"></div>
                <div class="tarot-overlay-2"></div>
                <div class="tarot-bg-glow"></div>

                <div class="tarot-card-content">
                  <span class="tarot-card-label">Rider-Waite Tarot</span>
                  <div>
                    <div class="tarot-card-symbol">☽ ★ ☽</div>
                    <div class="tarot-card-title">牌的語言</div>
                    <div class="tarot-card-divider"></div>
                    <p class="tarot-card-body">
                      每一張塔羅牌，<br/>
                      都是一面映照內心的鏡子。<br/><br/>
                      它不預測命運，<br/>
                      而是照見你當下的狀態，<br/>
                      與潛藏的可能性。
                    </p>
                  </div>
                </div>
              </div>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- ── 關於塔羅師 ──────────────────────────────────── -->
    <section class="tarot-page-intro">
      <div class="container">
        <div class="tarot-section-header" style="color:#2c1a08;" data-aos="fade-up">
          <span class="tarot-section-tag" style="color:#c87a30;">ABOUT THE READER</span>
          <h2 class="tarot-section-title" style="color:#2c1a08;">
            關於 <em style="color:#c87a30;text-shadow:0 0 20px rgba(200,122,48,0.3);">塔羅師</em> LuLu
          </h2>
        </div>

        <div class="tarot-intro-grid" data-aos="fade-up" data-aos-delay="80">
          <!-- 照片 -->
          <div class="tarot-intro-img">
            <img src="/img/lulu/lu02.webp" alt="LuLu 魯魯 塔羅師" loading="lazy" decoding="async" />
          </div>

          <!-- 文字 -->
          <div class="tarot-intro-text">
            <span class="tarot-eyebrow">MY STORY</span>
            <h3 class="tarot-intro-title">從護理到靈性，<br/>一張牌的相遇</h3>
            <p class="tarot-intro-body">
              擁有臨床護理背景，我習慣用觀察與傾聽陪伴他人。當我接觸偉特塔羅，才發現牌面的象徵語言正是另一種形式的「診斷工具」——它不診斷身體，而是讀懂靈魂。
            </p>
            <p class="tarot-intro-body">
              結合 MMT 天賦系統的人格分析能力與高敏感特質，每一次解牌對我而言都是一場深度對話。我不套用制式牌義，而是跟著你的故事，讓牌說出最貼近你此刻狀態的答案。
            </p>
            <div class="tarot-cta-row mt-4">
              <a href={booking.appointment} target="_blank" class="btn-tarot-line">
                <i class="bi bi-calendar-check"></i> 線上預約時段
              </a>
              <a href={contact.line} target="_blank" class="btn-tarot-line">
                <i class="bi bi-chat-fill"></i> LINE 預約
              </a>
              <a href={contact.instagram} target="_blank" class="btn-tarot-ig">
                <i class="bi bi-instagram"></i> IG 洽詢
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ── 偉特塔羅介紹 ─────────────────────────────────── -->
    <section class="tarot-rw-section">

      <!-- 粒子 -->
      <div class="magic-particles" aria-hidden="true">
        <span class="tarot-mp" style="top:8%;right:5%;--sz:0.9rem;--d:10s;--dl:0s;--op:0.40;">☽</span>
        <span class="tarot-mp" style="bottom:18%;left:4%;--sz:0.7rem;--d:13s;--dl:-5s;--op:0.35;">★</span>
        <span class="tarot-mp" style="top:50%;right:8%;--sz:0.6rem;--d:9s;--dl:-2s;--op:0.30;">✦</span>
      </div>

      <div class="container" style="position:relative;z-index:2;">

        <div class="tarot-section-header" data-aos="fade-up">
          <span class="tarot-section-tag">RIDER-WAITE TAROT</span>
          <h2 class="tarot-section-title">認識<em>偉特塔羅</em></h2>
        </div>

        <!-- 大 / 小阿爾克那 -->
        <div class="row g-4 mb-5">
          <div class="col-md-6" data-aos="fade-up" data-aos-delay="80">
            <div class="tarot-arcana-card">
              <div class="tarot-arcana-icon">☽</div>
              <h4>大阿爾克那 · Major Arcana</h4>
              <p>
                共 22 張，從「愚者」出發，歷經塔、星星、月亮、太陽……
                每一張對應人生中的重大課題與靈魂旅程，象徵宏觀的命運轉折與內在覺醒。
              </p>
            </div>
          </div>
          <div class="col-md-6" data-aos="fade-up" data-aos-delay="160">
            <div class="tarot-arcana-card">
              <div class="tarot-arcana-icon">★</div>
              <h4>小阿爾克那 · Minor Arcana</h4>
              <p>
                共 56 張，分屬聖杯、星幣、寶劍、權杖四組，
                細緻描繪日常情境、情感狀態、思維模式與行動力，
                映照你生活中每一個具體的當下。
              </p>
            </div>
          </div>
        </div>

        <!-- 四元素 -->
        <div class="tarot-section-header" data-aos="fade-up" style="margin-top:60px;">
          <span class="tarot-section-tag">FOUR SUITS</span>
          <h3 class="tarot-section-title" style="font-size:clamp(1.4rem,3vw,2rem);">四組牌組 · <em>四種力量</em></h3>
        </div>

        <div class="row g-3" data-aos="fade-up" data-aos-delay="80">
          <div class="col-6 col-md-3">
            <div class="tarot-suit-card">
              <div class="tarot-suit-icon">🏆</div>
              <h5>聖杯 Cups</h5>
              <p>情感 · 關係<br/>直覺 · 內在世界</p>
            </div>
          </div>
          <div class="col-6 col-md-3">
            <div class="tarot-suit-card">
              <div class="tarot-suit-icon">⭐</div>
              <h5>星幣 Pentacles</h5>
              <p>物質 · 事業<br/>財富 · 現實生活</p>
            </div>
          </div>
          <div class="col-6 col-md-3">
            <div class="tarot-suit-card">
              <div class="tarot-suit-icon">⚔️</div>
              <h5>寶劍 Swords</h5>
              <p>思維 · 溝通<br/>衝突 · 真相</p>
            </div>
          </div>
          <div class="col-6 col-md-3">
            <div class="tarot-suit-card">
              <div class="tarot-suit-icon">🔥</div>
              <h5>權杖 Wands</h5>
              <p>行動 · 熱情<br/>創意 · 意志力</p>
            </div>
          </div>
        </div>

      </div>
    </section>

    <!-- ── 預約 CTA ────────────────────────────────────── -->
    <section class="tarot-booking-section">

      <!-- 粒子 -->
      <div class="magic-particles" aria-hidden="true">
        <span class="mp" style="top:12%;right:8%;--sz:0.85rem;--d:9s;--dl:0s;--op:0.35;">✦</span>
        <span class="mp" style="bottom:15%;left:6%;--sz:0.7rem;--d:12s;--dl:-4s;--op:0.30;">✧</span>
        <span class="tarot-mp" style="top:40%;left:3%;--sz:0.65rem;--d:11s;--dl:-2s;--op:0.28;">☽</span>
        <span class="tarot-mp" style="bottom:30%;right:6%;--sz:0.55rem;--d:14s;--dl:-6s;--op:0.25;">★</span>
      </div>

      <div class="container" style="position:relative;z-index:2;" data-aos="fade-up">
        <h2 class="tarot-booking-title">準備好與牌對話了嗎？</h2>
        <p class="tarot-booking-sub">
          每一次解牌都是一場關於你自己的深度對話。<br/>
          透過 LINE 或 IG 與我聯繫，預約專屬的塔羅解讀。
        </p>
        <div class="tarot-booking-btns">
          <a href={booking.appointment} target="_blank" class="btn-tarot-line">
            <i class="bi bi-calendar-check"></i> 線上預約時段
          </a>
          <a href={contact.line} target="_blank" class="btn-tarot-line">
            <i class="bi bi-chat-fill"></i> LINE 預約解牌
          </a>
          <a href={contact.instagram} target="_blank" class="btn-tarot-ig">
            <i class="bi bi-instagram"></i> IG 追蹤 · 洽詢
          </a>
        </div>
      </div>
    </section>

  </main>
  <Footer />
</MainLayout>
