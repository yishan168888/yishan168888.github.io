---
import MainLayout from '../layouts/MainLayout.astro';
import SectionDivider from '../components/SectionDivider.astro';
import CornerOrnament from '../components/CornerOrnament.astro';
import { getCollection } from 'astro:content';
import site from '../data/site.json';
const { contact, booking } = site;
const insuranceProducts = (await getCollection('insuranceProducts')).sort((a, b) => a.data.order - b.data.order);
const testimonials = (await getCollection('testimonials')).sort((a, b) => a.data.order - b.data.order);

const whyCards = [
  { icon: '🩺', title: '護理專業背景', text: '臨床護理經驗讓我深刻理解醫療費用結構，能精準評估你真正需要的保障缺口，而非過度保險。' },
  { icon: '🧩', title: 'MMT 天賦分析', text: '透過 MMT 系統了解你的人格特質與風險承受度，為你設計最符合個性的保險組合，而非標準版。' },
  { icon: '💛', title: '高敏感同理心', text: '擅長傾聽，能讀懂你說不出口的擔憂。不用業績數字壓你，只想真正幫你找到安心的保障。' },
  { icon: '🌿', title: '全人陪伴視角', text: '結合靈性覺察與保險規劃，從身心靈整體出發，讓保險不只是數字，更是對自己全面的關愛。' },
];

const steps = [
  { n: '01', title: '初次接觸', text: '透過 Line 或 Instagram 聯繫，簡單說明你的需求與疑惑，預約 30 分鐘免費初談。' },
  { n: '02', title: '需求診斷', text: '深度了解你的生命階段、家庭狀況與財務目標，結合 MMT 天賦分析找出最真實的保障需求。' },
  { n: '03', title: '方案規劃', text: '根據預算與需求量身設計 2-3 套方案，清楚說明每份保單的優缺點，讓你充分比較。' },
  { n: '04', title: '保單說明', text: '用最白話的方式解讀保單條款，確認你真正理解每一項保障內容，不留任何疑問。' },
  { n: '05', title: '長期關懷', text: '成交後的服務才是開始。定期回顧保障是否仍符合你的人生狀態，隨時調整更新。' },
];
---
<MainLayout
  title="富邦保險諮詢 | LuLu"
  description="護理背景的富邦保險顧問 LuLu 魯魯：結合 MMT 天賦分析，為你量身規劃壽險、醫療、意外、重疾、年金與投資型保單。免費諮詢預約。"
  image="/img/lulu/lu01.webp"
  bodyClass="insurance-page cyber-page"
>

  <!-- ═══ HERO ═══ -->
  <section id="ins-hero" class="ins-cyber section" style="position:relative;overflow:hidden;">
    <CornerOrnament corner="tl" />
    <CornerOrnament corner="br" full={false} />
    <div class="aurora-overlay"><div class="aurora-1"></div><div class="aurora-3"></div></div>
    <div class="magic-particles" aria-hidden="true">
      <span class="mp" style="top:12%;right:6%;--sz:0.85rem;--d:9s;--dl:-1s;--op:0.42;">✦</span>
      <span class="mp" style="bottom:18%;left:4%;--sz:0.7rem;--d:11s;--dl:-4s;--op:0.38;">✧</span>
      <span class="mp" style="top:55%;right:14%;--sz:0.6rem;--d:8s;--dl:-6s;--op:0.30;">✸</span>
      <span class="mp" style="top:30%;left:8%;--sz:0.5rem;--d:13s;--dl:-2s;--op:0.28;">✺</span>
    </div>

    <div class="container" style="position:relative;z-index:2;" data-aos="fade-up">
      <div class="ins-hero-inner">
        <span class="cyber-section-tag">FUBON INSURANCE</span>
        <h1 class="ins-hero-title">富邦保險 · <em>專屬顧問服務</em></h1>
        <p class="ins-hero-sub">用護理人的溫柔，為你的未來<br />量身打造最適合的保障藍圖。</p>
        <div class="ins-hero-btns">
          <a href={contact.line} target="_blank" class="btn-cyber-primary"><span>立即預約諮詢</span><i class="bi bi-arrow-right"></i></a>
          <a href={booking.appointment} target="_blank" class="btn-cyber-ghost"><i class="bi bi-calendar-check"></i> 線上預約時段</a>
          <a href="#ins-products" class="btn-cyber-ghost">了解商品 ↓</a>
        </div>
        <div class="mmt-cyber-stats ins-hero-stats">
          {site.stats.insuranceHero.map((s) => (
            <div class="mmt-cyber-stat">
              <span class="mmt-cyber-stat-num">{s.num}{s.suffix}</span>
              <span class="mmt-cyber-stat-label">{s.label}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <SectionDivider variant={0} />

  <!-- ═══ PRODUCTS ═══ -->
  <section id="ins-products" class="ins-cyber section" style="position:relative;overflow:hidden;">
    <div class="magic-particles" aria-hidden="true">
      <span class="mp" style="top:8%;left:3%;--sz:0.7rem;--d:10s;--dl:-2s;--op:0.34;">✦</span>
      <span class="mp" style="bottom:12%;right:5%;--sz:0.8rem;--d:12s;--dl:-5s;--op:0.32;">✧</span>
    </div>
    <div class="container" style="position:relative;z-index:2;">
      <div class="cyber-section-header" data-aos="fade-up">
        <span class="cyber-section-tag">PRODUCTS</span>
        <h2 class="cyber-section-title">保險商品 · <em>溫柔的承諾</em></h2>
        <p class="ins-section-sub">每一份保單，都是對未來自己最溫柔的承諾</p>
      </div>
      <div class="row g-4 mt-2">
        {insuranceProducts.map((entry, i) => {
          const p = entry.data;
          return (
            <div class="col-lg-4 col-md-6" data-aos="fade-up" data-aos-delay={100 + (i % 3) * 100}>
              <div class={`value-cyber-card ins-product-card${p.featured ? ' is-featured' : ''}`}>
                <div class="card-shimmer"></div>
                {p.featured && <span class="ins-feat-badge">{p.featuredBadge}</span>}
                <div class="ins-product-icon">{p.icon}</div>
                <div class="ins-product-tag">{p.tag}</div>
                <h3>{p.title}</h3>
                <p>{p.description}</p>
                <ul class="ins-feature-list">
                  {p.features.map((f) => <li>{f}</li>)}
                </ul>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <SectionDivider variant={1} />

  <!-- ═══ WHY LULU ═══ -->
  <section class="ins-cyber ins-cyber-tinted section" style="position:relative;overflow:hidden;">
    <div class="aurora-overlay"><div class="aurora-2"></div></div>
    <div class="container" style="position:relative;z-index:2;">
      <div class="cyber-section-header" data-aos="fade-up">
        <span class="cyber-section-tag">WHY LULU</span>
        <h2 class="cyber-section-title">為什麼找 <em>魯魯</em> 諮詢</h2>
        <p class="ins-section-sub">不只是業務員，更是你生命旅途上的陪伴者</p>
      </div>
      <div class="row g-4 mt-2 align-items-center">
        <div class="col-lg-5" data-aos="fade-right">
          <div class="ins-lulu-img-wrap">
            <img src="/img/lulu/lu01.webp" alt="LuLu 魯魯" class="ins-lulu-img" loading="lazy" decoding="async" />
          </div>
        </div>
        <div class="col-lg-7" data-aos="fade-left" data-aos-delay="100">
          <div class="row g-3">
            {whyCards.map((c, i) => (
              <div class="col-sm-6" data-aos="fade-up" data-aos-delay={100 + i * 80}>
                <div class="value-cyber-card ins-why-card">
                  <div class="card-shimmer"></div>
                  <div class="ins-product-icon">{c.icon}</div>
                  <h3>{c.title}</h3>
                  <p>{c.text}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <SectionDivider variant={2} />

  <!-- ═══ PROCESS ═══ -->
  <section class="ins-cyber section" style="position:relative;overflow:hidden;">
    <div class="container" style="position:relative;z-index:2;">
      <div class="cyber-section-header" data-aos="fade-up">
        <span class="cyber-section-tag">PROCESS</span>
        <h2 class="cyber-section-title">諮詢 <em>流程</em></h2>
        <p class="ins-section-sub">從陌生到安心，每一步都有魯魯陪著你</p>
      </div>
      <div class="ins-steps" data-aos="fade-up" data-aos-delay="100">
        {steps.map((s, i) => (
          <>
            {i > 0 && <div class="ins-step-arrow">▸</div>}
            <div class="ins-step">
              <div class="ins-step-num">{s.n}</div>
              <h4>{s.title}</h4>
              <p>{s.text}</p>
            </div>
          </>
        ))}
      </div>
    </div>
  </section>

  <SectionDivider variant={3} />

  <!-- ═══ TESTIMONIALS ═══ -->
  <section class="ins-cyber ins-cyber-tinted section" style="position:relative;overflow:hidden;">
    <div class="magic-particles" aria-hidden="true">
      <span class="mp" style="top:10%;right:8%;--sz:0.7rem;--d:11s;--dl:-3s;--op:0.32;">✧</span>
      <span class="mp" style="bottom:14%;left:6%;--sz:0.8rem;--d:9s;--dl:-5s;--op:0.34;">✦</span>
    </div>
    <div class="container" style="position:relative;z-index:2;">
      <div class="cyber-section-header" data-aos="fade-up">
        <span class="cyber-section-tag">TESTIMONIALS</span>
        <h2 class="cyber-section-title">客戶 <em>見證</em></h2>
        <p class="ins-section-sub">真實回饋，來自每一段陪伴的旅程</p>
      </div>
      <div class="row g-4 mt-2">
        {testimonials.map((entry, i) => {
          const t = entry.data;
          return (
            <div class="col-lg-4" data-aos="fade-up" data-aos-delay={100 + i * 100}>
              <div class={`value-cyber-card ins-testi-card${t.featured ? ' is-featured' : ''}`}>
                <div class="card-shimmer"></div>
                <div class="ins-testi-stars">✦ ✦ ✦ ✦ ✦</div>
                <p class="ins-testi-text">{t.quote}</p>
                <div class="ins-testi-author">
                  <div class="ins-testi-avatar">{t.avatar}</div>
                  <div>
                    <div class="ins-testi-name">{t.name}</div>
                    <div class="ins-testi-role">{t.role}</div>
                  </div>
                </div>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <SectionDivider variant={0} />

  <!-- ═══ CTA ═══ -->
  <section class="ins-cyber section" style="position:relative;overflow:hidden;">
    <div class="magic-particles" aria-hidden="true">
      <span class="mp" style="top:20%;left:10%;--sz:0.8rem;--d:10s;--dl:-1s;--op:0.4;">✦</span>
      <span class="mp" style="top:60%;right:12%;--sz:0.7rem;--d:12s;--dl:-4s;--op:0.34;">✸</span>
    </div>
    <div class="container" style="position:relative;z-index:2;">
      <div class="ins-cta-panel" data-aos="zoom-in">
        <span class="cyber-section-tag">START YOUR JOURNEY</span>
        <h2 class="ins-cta-title">準備好守護你的未來了嗎？</h2>
        <p class="ins-cta-sub">現在預約免費諮詢，讓魯魯陪你找到最適合的保障。</p>
        <div class="ins-hero-btns">
          <a href={booking.appointment} target="_blank" class="btn-cyber-primary"><span>線上預約時段</span><i class="bi bi-calendar-check"></i></a>
          <a href={contact.line} target="_blank" class="btn-cyber-ghost"><i class="bi bi-chat-fill"></i> LINE 諮詢</a>
          <a href={contact.instagram} target="_blank" class="btn-cyber-ghost"><i class="bi bi-instagram"></i> Instagram</a>
        </div>
      </div>
    </div>
  </section>

</MainLayout>

<style is:global>
/* ══════════════════════════════════════════
   保險頁 — 深色魔法風（沿用全站 cyber 設計系統）
   只放保險頁專屬元件；卡片外觀重用 .value-cyber-card
══════════════════════════════════════════ */
.insurance-page .ins-cyber { padding: 100px 0; background: transparent; }
.insurance-page .ins-cyber-tinted { background: rgba(26, 16, 8, 0.045); }

.insurance-page .ins-section-sub {
  margin-top: 14px;
  color: rgba(26, 16, 8, 0.6);
  font-size: 0.92rem;
}

/* ── Hero ── */
.insurance-page .ins-hero-inner { max-width: 720px; margin: 0 auto; text-align: center; }
.insurance-page .ins-hero-title {
  font-family: 'Raleway', sans-serif;
  font-size: clamp(2.2rem, 5vw, 3.4rem);
  font-weight: 800;
  color: #2c1a08;
  line-height: 1.15;
  margin: 4px 0 18px;
}
.insurance-page .ins-hero-title em {
  font-style: normal;
  color: #a05c14;
  text-shadow: 0 0 28px rgba(160, 92, 20, 0.4), 0 0 56px rgba(160, 92, 20, 0.15);
}
.insurance-page .ins-hero-sub {
  font-size: 1.08rem;
  color: rgba(26, 16, 8, 0.66);
  line-height: 1.85;
  margin-bottom: 30px;
}
.insurance-page .ins-hero-btns {
  display: flex;
  gap: 14px;
  justify-content: center;
  flex-wrap: wrap;
}
.insurance-page .ins-hero-stats { max-width: 540px; margin: 36px auto 0; }

/* ── 商品卡片（重用 value-cyber-card，加 icon/tag/features） ── */
.insurance-page .ins-product-card { display: flex; flex-direction: column; }
.insurance-page .ins-product-icon {
  font-size: 2rem;
  line-height: 1;
  margin-bottom: 12px;
  filter: drop-shadow(0 0 10px rgba(160, 92, 20, 0.35));
}
.insurance-page .ins-product-tag {
  font-size: 0.62rem;
  letter-spacing: 0.22em;
  color: #a05c14;
  text-transform: uppercase;
  margin-bottom: 8px;
}
.insurance-page .ins-feature-list {
  list-style: none;
  padding: 14px 0 0;
  margin: 14px 0 0;
  border-top: 1px solid rgba(100, 65, 35, 0.16);
  font-size: 0.85rem;
  color: rgba(26, 16, 8, 0.72);
}
.insurance-page .ins-feature-list li { padding: 3px 0; }
.insurance-page .ins-feature-list li::before {
  content: '✦';
  color: #a05c14;
  margin-right: 8px;
  font-size: 0.7rem;
}
/* 推薦／主打卡片：琥珀邊框強調 */
.insurance-page .is-featured {
  border-color: rgba(160, 92, 20, 0.5) !important;
  box-shadow: 0 0 40px rgba(160, 92, 20, 0.16) !important;
}
.insurance-page .ins-feat-badge {
  position: absolute;
  top: 14px;
  right: 14px;
  z-index: 4;
  background: #a05c14;
  color: #f7f2ea;
  font-size: 0.6rem;
  font-weight: 700;
  letter-spacing: 0.15em;
  padding: 4px 10px;
}

/* ── Why LuLu 圖片 ── */
.insurance-page .ins-lulu-img-wrap { text-align: center; }
.insurance-page .ins-lulu-img {
  width: 100%;
  max-width: 380px;
  border: 1px solid rgba(160, 92, 20, 0.3);
  box-shadow: 0 0 50px rgba(140, 110, 80, 0.18);
  filter: sepia(8%) saturate(92%);
}
.insurance-page .ins-why-card .ins-product-icon { font-size: 1.6rem; margin-bottom: 8px; }

/* ── Process 流程 ── */
.insurance-page .ins-steps {
  display: flex;
  flex-wrap: wrap;
  align-items: flex-start;
  justify-content: center;
  gap: 8px;
}
.insurance-page .ins-step { flex: 0 0 auto; width: 168px; text-align: center; padding: 0 6px; }
.insurance-page .ins-step-num {
  width: 54px; height: 54px;
  margin: 0 auto 14px;
  display: flex; align-items: center; justify-content: center;
  font-family: 'Raleway', sans-serif;
  font-size: 1.1rem; font-weight: 800;
  color: #a05c14;
  background: rgba(160, 92, 20, 0.1);
  border: 1px solid rgba(160, 92, 20, 0.4);
  border-radius: 50%;
  box-shadow: 0 0 20px rgba(160, 92, 20, 0.2);
}
.insurance-page .ins-step h4 {
  font-family: 'Raleway', sans-serif;
  font-size: 0.98rem; font-weight: 700;
  color: #3e2d1c; margin-bottom: 6px;
}
.insurance-page .ins-step p { font-size: 0.82rem; color: rgba(26, 16, 8, 0.62); line-height: 1.65; }
.insurance-page .ins-step-arrow {
  color: rgba(160, 92, 20, 0.55);
  font-size: 1rem;
  align-self: flex-start;
  margin-top: 16px;
}
@media (max-width: 768px) {
  .insurance-page .ins-step { width: 44%; }
  .insurance-page .ins-step-arrow { display: none; }
  .insurance-page .ins-steps { gap: 24px; }
}

/* ── Testimonials ── */
.insurance-page .ins-testi-stars { color: #a05c14; letter-spacing: 0.3em; font-size: 0.7rem; margin-bottom: 14px; }
.insurance-page .ins-testi-text {
  font-size: 0.9rem; font-style: italic;
  color: rgba(26, 16, 8, 0.74); line-height: 1.85; margin-bottom: 18px;
}
.insurance-page .ins-testi-author {
  display: flex; align-items: center; gap: 12px;
  border-top: 1px solid rgba(100, 65, 35, 0.16); padding-top: 14px;
}
.insurance-page .ins-testi-avatar {
  width: 42px; height: 42px; flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
  font-family: 'Raleway', sans-serif; font-weight: 800;
  color: #f7f2ea; background: #a05c14; border-radius: 50%;
  box-shadow: 0 0 18px rgba(160, 92, 20, 0.35);
}
.insurance-page .ins-testi-name { font-weight: 700; color: #3e2d1c; font-size: 0.9rem; }
.insurance-page .ins-testi-role { font-size: 0.78rem; color: rgba(26, 16, 8, 0.55); }

/* ── CTA 面板（深色 statement 風） ── */
.insurance-page .ins-cta-panel {
  max-width: 660px; margin: 0 auto; text-align: center;
  background: #1a1008;
  border: 1px solid rgba(160, 92, 20, 0.3);
  box-shadow: 0 0 60px rgba(160, 92, 20, 0.14), inset 0 0 60px rgba(160, 92, 20, 0.04);
  padding: 48px 32px;
  clip-path: polygon(14px 0, 100% 0, calc(100% - 14px) 100%, 0 100%);
}
.insurance-page .ins-cta-panel .cyber-section-tag { color: #d68a3a; }
.insurance-page .ins-cta-title {
  font-family: 'Raleway', sans-serif; font-size: clamp(1.5rem, 3vw, 2.1rem); font-weight: 800;
  color: #f7f2ea; margin: 10px 0; text-shadow: 0 0 30px rgba(160, 92, 20, 0.25);
}
.insurance-page .ins-cta-sub { color: rgba(247, 242, 234, 0.6); margin-bottom: 26px; }

@media (max-width: 992px) { .insurance-page .ins-cyber { padding: 80px 0; } }
@media (max-width: 576px) { .insurance-page .ins-cyber { padding: 60px 0; } }
</style>
