---
---

<!-- SVG Turbulent Filter（電氣邊框動效） -->
<svg class="tarot-svg-filter" style="position:absolute;width:0;height:0;overflow:hidden;" aria-hidden="true">
  <defs>
    <filter id="tarot-turbulent-displace" colorInterpolationFilters="sRGB" x="-20%" y="-20%" width="140%" height="140%">
      <feTurbulence type="turbulence" baseFrequency="0.018" numOctaves="8" result="noise1" seed="3" />
      <feOffset in="noise1" dx="0" dy="0" result="offsetNoise1">
        <animate attributeName="dy" values="600; 0" dur="7s" repeatCount="indefinite" calcMode="linear" />
      </feOffset>
      <feTurbulence type="turbulence" baseFrequency="0.018" numOctaves="8" result="noise2" seed="3" />
      <feOffset in="noise2" dx="0" dy="0" result="offsetNoise2">
        <animate attributeName="dy" values="0; -600" dur="7s" repeatCount="indefinite" calcMode="linear" />
      </feOffset>
      <feTurbulence type="turbulence" baseFrequency="0.018" numOctaves="8" result="noise3" seed="7" />
      <feOffset in="noise3" dx="0" dy="0" result="offsetNoise3">
        <animate attributeName="dx" values="420; 0" dur="7s" repeatCount="indefinite" calcMode="linear" />
      </feOffset>
      <feTurbulence type="turbulence" baseFrequency="0.018" numOctaves="8" result="noise4" seed="7" />
      <feOffset in="noise4" dx="0" dy="0" result="offsetNoise4">
        <animate attributeName="dx" values="0; -420" dur="7s" repeatCount="indefinite" calcMode="linear" />
      </feOffset>
      <feComposite in="offsetNoise1" in2="offsetNoise2" result="part1" />
      <feComposite in="offsetNoise3" in2="offsetNoise4" result="part2" />
      <feBlend in="part1" in2="part2" mode="color-dodge" result="combinedNoise" />
      <feDisplacementMap in="SourceGraphic" in2="combinedNoise" scale="28" xChannelSelector="R" yChannelSelector="B" />
    </filter>
  </defs>
</svg>

<section id="tarot" class="tarot-cyber section">

  <!-- Aurora -->
  <div class="aurora-overlay">
    <div class="aurora-1"></div>
    <div class="aurora-2"></div>
  </div>

  <!-- 月相 + 星浮動粒子 -->
  <div class="magic-particles" aria-hidden="true">
    <span class="tarot-mp" style="top:8%;right:6%;--sz:1rem;--d:9s;--dl:0s;--op:0.45;">☽</span>
    <span class="tarot-mp" style="top:22%;left:3%;--sz:0.7rem;--d:12s;--dl:-3s;--op:0.35;">★</span>
    <span class="tarot-mp" style="bottom:12%;right:10%;--sz:0.85rem;--d:10s;--dl:-5s;--op:0.40;">☆</span>
    <span class="tarot-mp" style="top:55%;left:5%;--sz:0.6rem;--d:14s;--dl:-2s;--op:0.30;">☽</span>
    <span class="tarot-mp" style="top:35%;right:18%;--sz:0.5rem;--d:11s;--dl:-7s;--op:0.28;">✦</span>
    <span class="tarot-mp" style="bottom:28%;left:18%;--sz:0.75rem;--d:13s;--dl:-4s;--op:0.33;">★</span>
    <span class="tarot-mp" style="top:70%;right:4%;--sz:0.55rem;--d:8s;--dl:-1s;--op:0.27;">☆</span>
    <span class="tarot-mp" style="top:15%;left:40%;--sz:0.45rem;--d:16s;--dl:-9s;--op:0.22;">✦</span>
  </div>

  <!-- Corner Ornament -->
  <div class="corner-ornament corner-ornament--tr" aria-hidden="true">
    <div class="co-ring co-ring-1" style="border-color:rgba(200,122,48,0.35);"></div>
    <div class="co-ring co-ring-2" style="border-color:rgba(200,122,48,0.2);"></div>
    <div class="co-ring co-ring-3" style="border-color:rgba(200,122,48,0.1);"></div>
    <div class="co-dot" style="background:rgba(200,122,48,0.6);"></div>
    <div class="co-cross-h" style="background:rgba(200,122,48,0.3);"></div>
    <div class="co-cross-v" style="background:rgba(200,122,48,0.3);"></div>
  </div>
  <div class="corner-ornament corner-ornament--bl" aria-hidden="true">
    <div class="co-ring co-ring-1" style="border-color:rgba(200,122,48,0.3);"></div>
    <div class="co-ring co-ring-2" style="border-color:rgba(200,122,48,0.15);"></div>
    <div class="co-dot" style="background:rgba(200,122,48,0.5);"></div>
  </div>

  <div class="container" style="position:relative;z-index:2;">

    <!-- Section Header -->
    <div class="tarot-section-header" data-aos="fade-up">
      <span class="tarot-section-tag">TAROT READER</span>
      <h2 class="tarot-section-title">塔羅解讀 · <em>看見自己</em></h2>
    </div>

    <!-- 主區塊：左文 + 右電氣卡片 -->
    <div class="row align-items-center mb-5 g-5">

      <!-- 左欄：介紹文 + CTA -->
      <div class="col-lg-6" data-aos="fade-right" data-aos-delay="100">
        <span class="tarot-eyebrow">Rider-Waite Tarot · 偉特塔羅</span>
        <h3 class="tarot-title">與牌對話，<em>看見</em><br/>真正的自己</h3>
        <p class="tarot-body">
          學習偉特塔羅以來，我深刻感受到每一張牌背後承載的生命智慧。
          我以直覺與象徵語言為媒介，陪你穿越迷霧、看清當下的能量與方向。
          感情、事業、靈性探索——你的每一個問題，都值得被好好看見。
        </p>
        <div class="tarot-cta-row">
          <a href="https://line.me/ti/p/w7U_i0Dc0k" target="_blank" class="btn-tarot-line">
            <i class="bi bi-chat-fill"></i> LINE 預約諮詢
          </a>
          <a href="https://www.instagram.com/yishan168/" target="_blank" class="btn-tarot-ig">
            <i class="bi bi-instagram"></i> IG 追蹤洽詢
          </a>
        </div>
      </div>

      <!-- 右欄：電氣卡片 -->
      <div class="col-lg-6 d-flex justify-content-center" data-aos="fade-left" data-aos-delay="160">
        <div class="tarot-electric-wrap">
          <div class="tarot-electric-card">
            <div class="tarot-electric-inner">
              <div class="tarot-electric-border">
                <div class="tarot-electric-main"></div>
              </div>
              <div class="tarot-glow-1"></div>
              <div class="tarot-glow-2"></div>
            </div>
            <div class="tarot-overlay-1"></div>
            <div class="tarot-overlay-2"></div>
            <div class="tarot-bg-glow"></div>

            <div class="tarot-card-content">
              <span class="tarot-card-label">Rider-Waite Tarot</span>
              <div>
                <div class="tarot-card-symbol">☽</div>
                <div class="tarot-card-title">偉特塔羅</div>
                <div class="tarot-card-divider"></div>
                <p class="tarot-card-body">
                  由 78 張牌組成。<br/>
                  <strong style="color:rgba(232,148,58,0.9);">大阿爾克那</strong> 22 張，<br/>
                  掌管人生重大課題與靈魂旅程；<br/><br/>
                  <strong style="color:rgba(232,148,58,0.9);">小阿爾克那</strong> 56 張，<br/>
                  細緻描繪日常情境與內在狀態。<br/><br/>
                  每一張牌皆有其象徵語言，<br/>
                  引導你看見當下的能量訊息。
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- 三張主題卡片 -->
    <div class="row g-4 mt-2">
      <div class="col-md-4" data-aos="fade-up" data-aos-delay="100">
        <div class="tarot-theme-card">
          <div class="tarot-theme-icon">♥</div>
          <h4>感情解讀</h4>
          <p>釐清感情現況、關係動態與內心渴望，看見彼此之間的能量流動，找到最適合的前進方式。</p>
        </div>
      </div>
      <div class="col-md-4" data-aos="fade-up" data-aos-delay="200">
        <div class="tarot-theme-card">
          <div class="tarot-theme-icon">★</div>
          <h4>事業方向</h4>
          <p>看見職涯轉折的能量訊息與最佳時機，協助你在迷茫時找到屬於自己的下一步方向。</p>
        </div>
      </div>
      <div class="col-md-4" data-aos="fade-up" data-aos-delay="300">
        <div class="tarot-theme-card">
          <div class="tarot-theme-icon">☽</div>
          <h4>靈性成長</h4>
          <p>探索內在聲音與深層渴望，回到自己的生命節奏，連結更高維度的自我智慧。</p>
        </div>
      </div>
    </div>

    <!-- 了解更多 -->
    <div class="text-center mt-5" data-aos="fade-up" data-aos-delay="100">
      <a href="/tarot" class="btn-cyber-ghost" style="border-color:rgba(200,122,48,0.35);color:rgba(247,242,234,0.7);">
        深入了解塔羅服務 →
      </a>
    </div>

  </div>
</section>
