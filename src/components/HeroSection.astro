---
---
<section id="hero" class="hero section hero-cyber">

  <!-- Aurora layers -->
  <div class="aurora-overlay">
    <div class="aurora-1"></div>
    <div class="aurora-2"></div>
    <div class="aurora-3"></div>
  </div>

  <!-- Floating magic particles -->
  <div class="magic-particles" aria-hidden="true">
    <span class="mp" style="top:12%;left:6%;--sz:1.1rem;--d:7s;--dl:0s;--op:0.6;">✦</span>
    <span class="mp" style="top:22%;right:8%;--sz:0.7rem;--d:9s;--dl:-2s;--op:0.45;">✧</span>
    <span class="mp" style="top:55%;left:4%;--sz:0.9rem;--d:11s;--dl:-4s;--op:0.5;">✸</span>
    <span class="mp" style="top:70%;right:6%;--sz:1.2rem;--d:8s;--dl:-1s;--op:0.55;">✦</span>
    <span class="mp" style="top:35%;left:15%;--sz:0.55rem;--d:13s;--dl:-6s;--op:0.35;">✧</span>
    <span class="mp" style="top:80%;left:20%;--sz:0.75rem;--d:10s;--dl:-3s;--op:0.4;">✸</span>
    <span class="mp" style="top:18%;right:22%;--sz:0.65rem;--d:12s;--dl:-5s;--op:0.38;">✦</span>
    <span class="mp" style="top:65%;right:18%;--sz:0.85rem;--d:8.5s;--dl:-7s;--op:0.48;">✧</span>
    <span class="mp" style="top:45%;left:88%;--sz:0.6rem;--d:14s;--dl:-2.5s;--op:0.32;">✸</span>
    <span class="mp" style="top:88%;right:30%;--sz:0.9rem;--d:9.5s;--dl:-4.5s;--op:0.42;">✦</span>
  </div>

  <!-- Corner angle marks -->
  <div class="cyber-corner cyber-corner-tl"></div>
  <div class="cyber-corner cyber-corner-tr"></div>
  <div class="cyber-corner cyber-corner-bl"></div>
  <div class="cyber-corner cyber-corner-br"></div>

  <div class="hero-cyber-inner">
    <!-- System label -->
    <div class="cyber-sys-label" data-aos="fade-down" data-aos-delay="50">
      SOUL ADVISOR &nbsp;·&nbsp; MMT &nbsp;·&nbsp; 保險顧問
    </div>

    <!-- Name -->
    <span class="cyber-name" data-aos="fade-up" data-aos-delay="100">LuLu</span>
    <span class="cyber-zh-name" data-aos="fade-up" data-aos-delay="160">魯 &emsp; 魯</span>

    <!-- Description -->
    <p class="cyber-desc" data-aos="fade-up" data-aos-delay="220">
      照顧他人曾是我的職責，如今是我的選擇。<br />
      從護理走進富邦保險，我將療癒的本質帶進保障的世界，<br />
      透過 MMT 與塔羅陪伴你看見自己的光。
    </p>

    <!-- CTA -->
    <div class="cyber-cta" data-aos="fade-up" data-aos-delay="280">
      <a
        href="https://one-mercury.com/%e5%8d%94%e6%9c%83%e8%aa%8d%e8%ad%89%e5%b8%ab%e8%b3%87/?team_category=&team_gender=&searchName=%E9%AD%AF%E9%AD%AF"
        target="_blank"
        class="btn-cyber-primary"
      >MMT 預約一對一諮詢</a>
      <a href="#about-me" class="btn-cyber-ghost">了解我的專業</a>
    </div>

    <!-- Stats HUD -->
    <div class="cyber-stats-hud" data-aos="fade-up" data-aos-delay="340">
      <div class="cyber-stat-item">
        <span class="cyber-stat-num">300+</span>
        <span class="cyber-stat-label">陪跑個案</span>
      </div>
      <div class="cyber-stat-item">
        <span class="cyber-stat-num">5+</span>
        <span class="cyber-stat-label">探索年資</span>
      </div>
      <div class="cyber-stat-item">
        <span class="cyber-stat-num">50+</span>
        <span class="cyber-stat-label">講座紀錄</span>
      </div>
      <div class="cyber-stat-item">
        <span class="cyber-stat-num">120+</span>
        <span class="cyber-stat-label">保險諮詢</span>
      </div>
    </div>
  </div>
</section>
