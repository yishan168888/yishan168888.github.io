---
import '../styles/main.css';
import '../styles/theme-magic.css';
import '../styles/particles.css';
import '../styles/pixel-wizard.css';
import '../styles/magic-effects.css';
import '../styles/rune-ring.css';
import '../styles/section-divider.css';
import '../styles/corner-ornament.css';
import '../styles/card-hover-magic.css';
import '../styles/cursor-trail.css';

interface Props {
  title?: string;
  bodyClass?: string;
}

const { title = 'LuLu | Personal Advisor for Life & Soul', bodyClass = 'index-page' } = Astro.props;
---
<!DOCTYPE html>
<html lang="zh-TW">
  <head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>{title}</title>
    <meta name="description" content="" />
    <meta name="keywords" content="" />

    <!-- Favicons -->
    <link href="/img/favicon.png" rel="icon" />
    <link href="/img/apple-touch-icon.png" rel="apple-touch-icon" />

    <!-- Fonts -->
    <link href="https://fonts.googleapis.com" rel="preconnect" />
    <link href="https://fonts.gstatic.com" rel="preconnect" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100;0,300;0,400;0,500;0,700;0,900;1,100;1,300;1,400;1,500;1,700;1,900&family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=Raleway:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap"
      rel="stylesheet"
    />

    <!-- Vendor CSS -->
    <link href="/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
    <link href="/vendor/bootstrap-icons/bootstrap-icons.css" rel="stylesheet" />
    <link href="/vendor/aos/aos.css" rel="stylesheet" />
    <link href="/vendor/swiper/swiper-bundle.min.css" rel="stylesheet" />
    <link href="/vendor/glightbox/css/glightbox.min.css" rel="stylesheet" />

    <!-- SweetAlert2 -->
    <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11.15.3/dist/sweetalert2.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.15.3/dist/sweetalert2.all.min.js" is:inline></script>

    <!-- Font Awesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />

    <!-- Noto Sans TC -->
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC&display=swap" rel="stylesheet" />

    <slot name="head" />
  </head>

  <body class={bodyClass}>
    <slot />

    <!-- Vendor JS（body 尾端依序載入，is:inline 防止 Astro 打包） -->
    <script src="/vendor/bootstrap/js/bootstrap.bundle.min.js" is:inline></script>
    <script src="/vendor/php-email-form/validate.js" is:inline></script>
    <script src="/vendor/aos/aos.js" is:inline></script>
    <script src="/vendor/purecounter/purecounter_vanilla.js" is:inline></script>
    <script src="/vendor/imagesloaded/imagesloaded.pkgd.min.js" is:inline></script>
    <script src="/vendor/isotope-layout/isotope.pkgd.min.js" is:inline></script>
    <script src="/vendor/swiper/swiper-bundle.min.js" is:inline></script>
    <script src="/vendor/glightbox/js/glightbox.min.js" is:inline></script>

    <!-- Main JS -->
    <script src="/js/main.js" is:inline></script>

    <!-- Cursor Trail -->
    <script src="/js/cursor-trail.js" is:inline></script>
  </body>
</html>
